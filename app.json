{
  "expo": {
    "name": "gym-track",
    "slug": "gym-track",
    "version": "1.0.0",
    "scheme": "gym-track",
    "platforms": ["ios", "android"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-video",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3a5641d-69fd-431f-a580-4c154be97412"
      }
    },
    "owner": "vgarcia_mistral",
    "runtimeVersion": {
      "policy": "nativeVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "url": "https://u.expo.dev/f3a5641d-69fd-431f-a580-4c154be97412"
    }
  }
}
