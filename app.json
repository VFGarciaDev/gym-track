{
  "expo": {
    "name": "fran-gym",
    "slug": "fran-gym",
    "version": "1.0.0",
    "scheme": "fran-gym",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-video",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vgarciadev.frangym",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e8d2d42-c50d-4a45-98b2-4106a8347386"
      }
    },
    "owner": "vgarcia_mistral",
    "runtimeVersion": {
      "policy": "nativeVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "url": "https://u.expo.dev/5e8d2d42-c50d-4a45-98b2-4106a8347386"
    }
  }
}
